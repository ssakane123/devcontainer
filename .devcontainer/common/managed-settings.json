{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "env": {
    "CLAUDE_CODE_ALWAYS_ENABLE_EFFORT": "1",
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "10",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Read",
      "Glob",
      "Grep",
      "TodoWrite",
      "ExitPlanMode",
      "WebSearch",
      "WebFetch",
      "mcp__ide__getDiagnostics"
    ],
    "ask": [
      "Bash(eval*)",
      "Bash(exec*)",
      "Bash(wget*)",
      "Bash(nc *)",
      "Bash(netcat*)",
      "Bash(scp*)",
      "Bash(git commit*--amend*)",
      "Bash(git rebase --interactive*)",
      "Bash(git rebase -i*)"
    ],
    "deny": [
      "Bash(npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)",
      "Bash(twine upload*)",
      "Bash(cargo publish*)",
      "Bash(docker push*)",
      "Bash(gh release create*)",
      "Bash(gh release upload*)",
      "Bash(git push*)",
      "Bash(ssh*)",
      "Bash(sudo*)",
      "Bash(su *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Read(//home/vscode/.claude/.credentials.json)",
      "Edit(//home/vscode/.claude/.credentials.json)",
      "Read(//home/vscode/.claude.json)",
      "Edit(//home/vscode/.claude.json)",
      "Read(//home/vscode/.claude/_user_config.json)",
      "Edit(//home/vscode/.claude/_user_config.json)",
      "Read(//home/vscode/.claude/cliproxy-client-key)",
      "Edit(//home/vscode/.claude/cliproxy-client-key)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(//etc/claude-code/**)",
      "Bash(sudo:*)",
      "Edit(//home/vscode/.claude/hud/**)",
      "Edit(//home/vscode/.claude/CLAUDE.md)"
    ],
    "disableBypassPermissionsMode": "disable",
    "defaultMode": "auto"
  },
  "allowManagedPermissionRulesOnly": true,
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "node \"${HOME}/.claude/hud/omc-hud.mjs\""
  },
  "allowManagedHooksOnly": true,
  "allowedHttpHookUrls": [],
  "allowedMcpServers": [],
  "allowManagedMcpServersOnly": true,
  "enableAllProjectMcpServers": false,
  "disableSideloadFlags": true,
  "disableClaudeAiConnectors": true
}
