{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "apiKeyHelper": "/usr/bin/cat /home/vscode/.claude/cliproxy-client-key",
  "model": "opus[1m]",
  "env": {
    "ANTHROPIC_BASE_URL": "http://host.docker.internal:18317",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "gpt-6-luna",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "gpt-5.6-terra",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "gpt-6.1-sol",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "gpt-6-astra",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort,max_effort,thinking,adaptive_thinking,interleaved_thinking",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort,max_effort,thinking,adaptive_thinking,interleaved_thinking",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort,max_effort,thinking,adaptive_thinking,interleaved_thinking",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_SUPPORTED_CAPABILITIES": "effort,xhigh_effort,max_effort,thinking,adaptive_thinking,interleaved_thinking",
    "CLAUDE_CODE_ALWAYS_ENABLE_EFFORT": "1",
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "10",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "272000"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Read",
      "Glob",
      "Grep",
      "TodoWrite",
      "ExitPlanMode",
      "WebSearch",
      "WebFetch",
      "mcp__ide__getDiagnostics"
    ],
    "ask": [
      "Bash(eval*)",
      "Bash(exec*)",
      "Bash(wget*)",
      "Bash(nc *)",
      "Bash(netcat*)",
      "Bash(scp*)",
      "Bash(git commit*--amend*)",
      "Bash(git rebase --interactive*)",
      "Bash(git rebase -i*)"
    ],
    "deny": [
      "Bash(npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)",
      "Bash(twine upload*)",
      "Bash(cargo publish*)",
      "Bash(docker push*)",
      "Bash(gh release create*)",
      "Bash(gh release upload*)",
      "Bash(git push*)",
      "Bash(ssh*)",
      "Bash(sudo*)",
      "Bash(su *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Read(//home/vscode/.claude/.credentials.json)",
      "Edit(//home/vscode/.claude/.credentials.json)",
      "Read(//home/vscode/.claude.json)",
      "Edit(//home/vscode/.claude.json)",
      "Read(//home/vscode/.claude/_user_config.json)",
      "Edit(//home/vscode/.claude/_user_config.json)",
      "Read(//home/vscode/.flava/mcp-hub.json)",
      "Edit(//home/vscode/.flava/mcp-hub.json)",
      "Read(//home/vscode/.claude/cliproxy-client-key)",
      "Edit(//home/vscode/.claude/cliproxy-client-key)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(//etc/claude-code/**)",
      "Bash(sudo:*)",
      "Edit(//home/vscode/.claude/hud/**)",
      "Edit(//home/vscode/.claude/CLAUDE.md)"
    ],
    "disableBypassPermissionsMode": "disable",
    "defaultMode": "auto"
  },
  "allowManagedPermissionRulesOnly": true,
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "node \"${HOME}/.claude/hud/omc-hud.mjs\""
  },
  "allowManagedHooksOnly": true,
  "allowedHttpHookUrls": [],
  "allowedMcpServers": [],
  "allowManagedMcpServersOnly": true,
  "enableAllProjectMcpServers": false,
  "disableSideloadFlags": true,
  "disableClaudeAiConnectors": true
}
